# secrets/langfuse.env.example  (COMMITTED — PLACEHOLDERS ONLY)
#
# Per-namespace view of the `langfuse` namespace's sensitive keys. These are a SUBSET
# of secrets/shared.env.example and DERIVE FROM the single shared.env.dec at runtime —
# the sync task materializes the `langfuse-app-secrets` Secret from the shared file
# (§11.3). This file exists for documentation/reference; it is NOT consumed separately.
#
# Note: DATABASE_URL is NOT here — Langfuse consumes the CNPG-minted `uri` from the
# `langfuse-pg-app` Secret via secretKeyRef (§11.3.2), not a hand-built literal.

# Bootstrap admin identity. EMAIL is the placeholder admin (non-secret, also in mise);
# the PASSWORD is sensitive.
LANGFUSE_INIT_USER_EMAIL=admin@ai-infra-platform.example
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=CHANGEME-langfuse-admin
LANGFUSE_ADMIN_PASSWORD=CHANGEME-langfuse-admin

# Pre-generated project API keys fed to bootstrap so they are deterministic and
# shareable with LiteLLM/host hooks at boot.
LANGFUSE_INIT_ORG_ID=ai-infra-platform
LANGFUSE_INIT_PROJECT_ID=ai-infra-platform
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=<fnox+age-managed>
LANGFUSE_INIT_PROJECT_SECRET_KEY=<fnox+age-managed>
LANGFUSE_PUBLIC_KEY=<fnox+age-managed>
LANGFUSE_SECRET_KEY=<fnox+age-managed>

# WRITE-ONCE values. Rotating either after first boot permanently invalidates stored
# API keys and renders encrypted fields undecryptable. NEVER rotate (§11.2 / §11.6).
LANGFUSE_SALT=CHANGEME-langfuse-salt                  # generate ONCE; NEVER rotate
LANGFUSE_ENCRYPTION_KEY=CHANGEME-langfuse-encryption  # generate ONCE; NEVER rotate

# NextAuth session secret.
LANGFUSE_NEXTAUTH_SECRET=CHANGEME-langfuse-nextauth

# Datastore passwords this namespace reaches (mirrored from shared.env.dec).
LANGFUSE_PG_PASSWORD=CHANGEME-langfuse-pg
VALKEY_PASSWORD=CHANGEME-valkey
