# secrets/shared.env.example  (COMMITTED — PLACEHOLDERS ONLY, never real values)
#
# This is the template that documents EVERY sensitive key name a new operator must
# populate. The real values live ONLY in fnox+age ciphertext in the GITIGNORED
# repo-root fnox.local.toml (the committed fnox.toml is a marker-only template) and
# are materialized at runtime into a GITIGNORED secrets/shared.env.dec by
# `mise run secrets:sync`. There is no committed secrets/shared.env with real values.
#
# Workflow for a new operator:
#   1) mise run secrets:keygen      # age key + recipients; creates gitignored fnox.local.toml
#   2) mise run secrets:generate    # create gitignored secrets/shared.env with random values
#   3) edit only optional/manual values if needed (for example Docker Hub cache auth)
#   4) mise run secrets:seal        # encrypt fnox-managed values -> fnox.local.toml ciphertext
#
# Placeholder convention: <fnox+age-managed> and CHANGEME-<component> are
# publication-safe markers only. Do not run the platform with these values; generate
# real random values with `mise run secrets:generate`.

# --- LiteLLM: master + per-client virtual keys (virtual keys are also Job-minted) ---
LITELLM_MASTER_KEY=CHANGEME-litellm-master
CLAUDE_CODE_LITELLM_VIRTUAL_KEY=<fnox+age-managed>
CODEX_LITELLM_VIRTUAL_KEY=<fnox+age-managed>
SMOKE_TEST_LITELLM_VIRTUAL_KEY=<fnox+age-managed>

# --- Grafana admin (USERNAME is non-secret in mise: GRAFANA_ADMIN_USER=admin) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGEME-grafana

# --- Langfuse bootstrap + project keys ---
# Admin EMAIL is non-secret (admin@ai-infra-platform.example, set in mise); password here.
LANGFUSE_INIT_USER_EMAIL=admin@ai-infra-platform.example
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=CHANGEME-langfuse-admin
LANGFUSE_INIT_ORG_ID=ai-infra-platform
LANGFUSE_INIT_PROJECT_ID=ai-infra-platform
LANGFUSE_ADMIN_PASSWORD=CHANGEME-langfuse-admin
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=<fnox+age-managed>
LANGFUSE_INIT_PROJECT_SECRET_KEY=<fnox+age-managed>
LANGFUSE_PUBLIC_KEY=<fnox+age-managed>
LANGFUSE_SECRET_KEY=<fnox+age-managed>
LANGFUSE_SALT=CHANGEME-langfuse-salt                  # generate ONCE; NEVER rotate
LANGFUSE_NEXTAUTH_SECRET=CHANGEME-langfuse-nextauth
LANGFUSE_ENCRYPTION_KEY=CHANGEME-langfuse-encryption  # generate ONCE; NEVER rotate

# --- Datastore passwords ---
# Each CNPG <cluster>-app Secret pre-creates username+password from these; the
# operator then adopts them and mints the `uri` key on top (sync.sh materializes
# the username+password as a kubernetes.io/basic-auth Secret).
LANGFUSE_PG_PASSWORD=CHANGEME-langfuse-pg
LITELLM_PG_PASSWORD=CHANGEME-litellm-pg
GRAFANA_PG_PASSWORD=CHANGEME-grafana-pg          # CNPG grafana-pg (lgtm) app password
CLICKHOUSE_PASSWORD=CHANGEME-clickhouse
VALKEY_PASSWORD=CHANGEME-valkey

# --- SeaweedFS embedded-S3 (shared with Loki/Tempo S3 in LGTM) ---
SEAWEEDFS_S3_ACCESS_KEY=CHANGEME-seaweedfs-access
SEAWEEDFS_S3_SECRET_KEY=CHANGEME-seaweedfs-secret

# --- Docker Hub pull-through cache auth (OPTIONAL — read DIRECTLY from this gitignored
#     secrets/shared.env at runtime by `mise run cache:up`; NOT sealed into fnox, NOT a
#     Kubernetes Secret). Set these to authenticate the `ai-registry` pull-through cache
#     to Docker Hub for HIGHER pull limits (authenticated personal: 200 pulls / 6h vs
#     anonymous 100). If left as placeholders / absent, the cache still works ANONYMOUSLY
#     (cache:up logs a warning). Use a Docker Hub ACCESS TOKEN, not your account password.
#     SECURITY: the token only ever lives in this gitignored file (input) and the
#     gitignored .local/registry/config.yml (output) — never in a committed file. ---
DOCKERHUB_USERNAME=CHANGEME-dockerhub-username
DOCKERHUB_TOKEN=CHANGEME-dockerhub-access-token
