# secrets/grafana.env.example  (COMMITTED — PLACEHOLDERS ONLY)
#
# Per-namespace view of the `lgtm` (observability) namespace's Grafana admin secret.
# This is a SUBSET of secrets/shared.env.example and DERIVES FROM the single
# shared.env.dec at runtime — the sync task materializes the `grafana-admin` Secret
# from the shared file (§11.3). This file exists for documentation/reference; it is
# NOT consumed separately.
#
# The Grafana admin USERNAME is non-secret and lives in mise (GRAFANA_ADMIN_USER=admin);
# only the PASSWORD is sensitive (fnox+age). Grafana is localhost-only via port-forward
# at 127.0.0.1:3001 with anonymous access disabled.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGEME-grafana

# Grafana's database is the dedicated CNPG `grafana-pg` cluster (lgtm). sync.sh
# pre-creates the grafana-pg-app basic-auth Secret (username `grafana` + this
# password); CNPG adopts it and mints the `uri`. Grafana reads the `password` key as
# GF_DATABASE_PASSWORD.
GRAFANA_PG_PASSWORD=CHANGEME-grafana-pg
