# secrets/litellm.env.example  (COMMITTED — PLACEHOLDERS ONLY)
#
# Per-namespace view of the `litellm` namespace's sensitive keys. These are a SUBSET
# of secrets/shared.env.example and DERIVE FROM the single shared.env.dec at runtime —
# the sync task materializes the `litellm-app-secrets` Secret from the shared file
# (§11.3). This file exists for documentation/reference; it is NOT consumed separately.
#
# Note: DATABASE_URL is NOT here — LiteLLM consumes the CNPG-minted `uri` from the
# `litellm-pg-app` Secret via secretKeyRef (§11.3.2), not a hand-built literal.

# LiteLLM admin master key (gates /key/*, /team/*, /user/*; admin-only).
LITELLM_MASTER_KEY=CHANGEME-litellm-master

# CNPG litellm-pg app-user password (mirrored into the litellm-pg-app bootstrap Secret).
LITELLM_PG_PASSWORD=CHANGEME-litellm-pg

# Langfuse callback project keys (LiteLLM success/failure callback to Langfuse).
LANGFUSE_PUBLIC_KEY=<fnox+age-managed>
LANGFUSE_SECRET_KEY=<fnox+age-managed>

# Per-client virtual keys are MINTED AT RUNTIME by the LiteLLM key Job (§11.4) into
# litellm-key-<alias> Secrets; the same plaintext is mirrored into fnox so host-side
# clients can read it. They are shown here only as the placeholder names:
CLAUDE_CODE_LITELLM_VIRTUAL_KEY=<fnox+age-managed>
CODEX_LITELLM_VIRTUAL_KEY=<fnox+age-managed>
SMOKE_TEST_LITELLM_VIRTUAL_KEY=<fnox+age-managed>
