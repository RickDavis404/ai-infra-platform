# EditorConfig — https://editorconfig.org
# 2-space indent, LF, final newline, trim trailing whitespace (except Markdown).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown uses trailing whitespace for hard line breaks; do not trim.
[*.md]
trim_trailing_whitespace = false

# Makefiles require literal tabs for recipe lines.
[{Makefile,makefile,*.mk}]
indent_style = tab

# Go source is gofmt-tabbed (vendored skill utilities, if any).
[*.go]
indent_style = tab
