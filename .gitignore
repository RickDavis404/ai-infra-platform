# ===== ai-infra-platform .gitignore =====
# A fresh clone is safe by default. This is authoritative; do NOT rely on a
# user-global git ignore. The working-tree scrub guard + gitleaks back it up.

# --- age private keys / identities (NEVER commit) ---
*.agekey
age.txt
age-*.txt
*age*.key
*.agekeyfile
.config/fnox/age.txt
secrets/age/
*.key
key.txt

# --- fnox runtime / decrypted material (NEVER commit) ---
*.dec
secrets/*.dec
*.env.runtime
secrets/*.env.runtime
secrets/*.env
secrets/*.env.*
.env
.env.*
!.env.example
!secrets/*.env.example
.fnox/
# The repo-root fnox.toml is the committed (age-encrypted) secret store — keep it
# tracked (negation is defensive; no rule above ignores it).
!/fnox.toml
# ...but never commit a local, unencrypted fnox override.
/fnox.local.toml
/fnox.*.local.toml

# --- rendered / generated secret manifests ---
**/rendered-secrets*.yaml
*secret*.runtime.yaml
*-secret.generated.yaml
rendered-secrets/

# --- TLS / key material ---
*.pem
*.crt
*.cert
*.p12
*.pfx
*.kubeconfig

# --- local cluster credentials (Lima copyToHost) ---
.kube/
.sandbox-*/.kube/
**/kubeconfig

# --- vendored Helm chart cache (re-pulled by `kustomize build --enable-helm`) ---
kubernetes/**/charts/

# --- validation working file (committed counterpart: forbidden-names.txt.example) ---
.config/mise/lib/forbidden-names.txt

# --- agent local / state (host-specific, may carry captured content) ---
# settings.local* also covers timestamped .bak variants (they can carry real
# home paths and proxy-hop keys); settings.*.json catches editing strays
# (settings.bak.*.json, settings.old.json). The canonical settings.json and the
# committed *.example template stay un-ignored.
**/.claude/settings.local*
**/.claude/settings.*.json
!**/.claude/settings.local.json.example
.claude/otel-raw-bodies/
.claude/state/
!.claude/state/.gitignore
# saved dynamic-workflow scripts embed the machine-absolute repo path (host-specific,
# not part of the published deliverable; live .claude is scrubbed at publish time)
.claude/workflows/
**/.codex/auth.json
**/.codex/*.local.*

# --- Lima host mounts (writable virtiofs mount tree per VM; D005) ---
# ./.local/lima/<vm>/{storage,config,...} — host-visible PVC + service config data
# bind-mounted into each Lima guest. Host-specific, regenerated by `mise run up`.
.local/

# --- caches / build artifacts ---
__pycache__/
*.pyc
.DS_Store

# --- init-written per-host network/IP override (never commit) ---
.config/mise/conf.d/99-local.toml

# --- pre-publication working material (never publish) ---
# planning/ was the private spec-drafting workspace (archived to .local/archive/);
# ignored so an agent recreating worklog paths can never re-stage it.
planning/
# publication-safety review findings (reproduces the scrubbed tokens by design)
PUBLICATION-REVIEW-FINDINGS.md
PUBLICATION-COMMIT-PLAN.md
# internal working notes for in-flight efforts (session/plan refs, operational detail)
implementation-notes.md
# editing-stray backups anywhere (e.g. .mcp.bak.<date>.json) are never deliverables
*.bak.*
